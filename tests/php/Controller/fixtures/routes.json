                    "maintenance-sync-synonyms": {
                        "type": "Laminas\\Router\\Http\\Literal",
                        "options": {
                            "route": "/maintenance/sync-synonyms",
                            "defaults": {
                                "controller": "IwacSearch\\Controller\\Admin\\MaintenanceController",
                                "action": "syncSynonyms"
                            }
                        }
                    },
                    "maintenance-provision-analytics": {
                        "type": "Laminas\\Router\\Http\\Literal",
                        "options": {
                            "route": "/maintenance/provision-analytics",
                            "defaults": {
                                "controller": "IwacSearch\\Controller\\Admin\\MaintenanceController",
                                "action": "provisionAnalytics"
                            }
                        }
                    }
                }
            }
        }
    },
    "iwac-search": {
        "type": "Laminas\\Router\\Http\\Literal",
        "options": {
            "route": "/search",
            "defaults": {
                "controller": "IwacSearch\\Controller\\SearchController",
                "action": "index"
            }
        }
    },
    "iwac-search-everything": {
        "type": "Laminas\\Router\\Http\\Literal",
        "options": {
            "route": "/search/everything",
            "defaults": {
                "controller": "IwacSearch\\Controller\\SearchController",
