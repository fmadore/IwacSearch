{
    "admin": {
        "child_routes": {
            "iwac-search": {
                "type": "Laminas\\Router\\Http\\Literal",
                "options": {
                    "route": "/iwac-search",
                    "defaults": {
                        "__NAMESPACE__": "IwacSearch\\Controller\\Admin",
                        "controller": "IwacSearch\\Controller\\Admin\\MaintenanceController",
                        "action": "index"
                    }
                },
                "may_terminate": true,
                "child_routes": {
                    "maintenance": {
                        "type": "Laminas\\Router\\Http\\Literal",
                        "options": {
                            "route": "/maintenance",
                            "defaults": {
                                "controller": "IwacSearch\\Controller\\Admin\\MaintenanceController",
                                "action": "index"
                            }
                        }
                    },
                    "maintenance-retry-changes": {
                        "type": "Laminas\\Router\\Http\\Literal",
