<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit tests for the module's pure seams — the code that needs neither
  Typesense nor MySQL nor an Omeka bootstrap.

  Deliberately NOT covered: OmekaSourceReader (its whole job is SQL, and
  Doctrine DBAL is an Omeka-core dependency this module doesn't ship), the
  controllers and the block layout (they extend Laminas/Omeka base classes
  that aren't installable standalone), and the Job classes (thin wrappers
  over an AbstractJob we don't have). Those seams are exercised by the
  stack in IWAC-docker; what's here is what can be pinned honestly and
  fast, which is also where the behaviour actually lives.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/php/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnRisky="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnWarning="true"
         failOnNotice="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerErrors="true">
    <testsuites>
        <testsuite name="IwacSearch">
            <directory>tests/php</directory>
        </testsuite>
    </testsuites>
    <!-- Fail on the deprecations, notices and warnings this module's own code
         triggers: production runs PHP 8.5, where a deprecation today is a
         removal tomorrow. The restrict*/ignoreIndirect* attributes scope that
         to the source below, so a deprecation raised inside a vendor package
         (Guzzle, symfony/yaml, typesense-php) is reported by that package,
         not failed here. Same settings as DRESearch's phpunit.xml.dist. -->
    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
            <file>Module.php</file>
        </include>
    </source>
</phpunit>
