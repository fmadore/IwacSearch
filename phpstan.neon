# Static analysis for the PHP side. Runs in CI as a blocking gate, on both
# PHP legs.
#
# Against the released Omeka S 4.2.1 runtime, not stubs: Omeka is an
# application, not a Packagist library, and it pins its own Laminas (with its
# own forks of laminas-mvc and laminas-log), so the only faithful source of
# the framework's signatures is the vendor tree the release zip ships.
# tools/phpstan/bootstrap.php loads it from OMEKA_VENDOR the way production
# boots (Omeka's bootstrap.php, then the module's autoloader in front); CI
# downloads the zip and checks its sha256. Locally:
#
#   OMEKA_VENDOR=/path/to/omeka-s/vendor/autoload.php vendor/bin/phpstan analyse
#
# Run `vendor/bin/phpstan clear-result-cache` after pointing OMEKA_VENDOR
# elsewhere: the result cache does not know the Omeka tree changed.
#
# tools/phpstan/omeka.stub holds only what that tree cannot declare (the view
# helpers and controller plugins Laminas resolves through __call, and core
# docblocks that state the wrong type); its header says why each is there.

parameters:
    level: 6

    paths:
        - src
        - Module.php
        - config
        - tests/php

    bootstrapFiles:
        - tools/phpstan/bootstrap.php

    stubFiles:
        - tools/phpstan/omeka.stub

    # cli/ is excluded: those scripts run outside the Omeka bootstrap and build
    # their own container/connection from ini files, so they are covered by
    # `php -l` in CI and exercised by hand on the live stack.
    excludePaths:
        - cli/*
        # Declares the few Omeka/Laminas types PHPUnit's standalone run needs;
        # here the real classes are loaded, and two declarations collide.
        - tests/php/runtime-stubs.php

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # PresetCatalog::all() is a literal map, so PHPStan can constant-fold
        # `get('index')` and prove it non-null — which makes the `?->` look
        # redundant. It is not: these are the documented fallbacks for a
        # preset being renamed or removed, and the whole point is that they
        # keep working when the catalogue changes. Keeping the defensive form
        # costs nothing; deleting it would turn a future rename into a fatal.
        -
            identifier: nullsafe.neverNull
            paths:
                - src/Controller/SearchController.php
                - src/Site/BlockLayout/IwacSearchBlock.php

        # Test doubles of the view renderer. The module's API takes the
        # PhpRenderer that Omeka hands block layouts and view helpers, so a
        # double has to be one. laminas-view's @final announces a future
        # major; 4.2.1's class is not final, and production code never
        # extends it (this ignore covers tests/php only).
        -
            identifier: class.extendsFinalByPhpDoc
            path: tests/php/*
