# Maintenance page messages (src/Controller/Admin/MaintenanceController.php)
msgid "IWAC Search database setup is incomplete. Open Modules and upgrade IWAC Search. If no upgrade is offered, ask your administrator to run php cli/repair-schema.php from the IwacSearch module directory, then reload this page. Run a full reindex after recovery."
msgstr "La configuration de la base de données de Recherche IWAC est incomplète. Ouvrez Modules et mettez à jour IwacSearch. Si aucune mise à jour n'est proposée, demandez à votre administrateur d'exécuter php cli/repair-schema.php depuis le répertoire du module IwacSearch, puis rechargez cette page. Lancez ensuite une réindexation complète."

msgid "IWAC Search could not read its indexing queue. Check the Omeka database connection and permissions before running maintenance."
msgstr "Recherche IWAC n'a pas pu lire sa file d'indexation. Vérifiez la connexion à la base de données Omeka et ses droits d'accès avant toute opération de maintenance."

msgid "Content (articles, documents, publications, references)"
msgstr "Contenus (articles, documents, publications, références)"

msgid "Entity index (people, places, organisations, topics…)"
msgstr "Index des entités (personnes, lieux, organisations, sujets…)"

msgid "Invalid form submission. Please reload the page and try again."
msgstr "Envoi du formulaire non valide. Veuillez recharger la page et réessayer."

msgid "IWAC Search database setup is unavailable. Open the maintenance page for recovery instructions before retrying."
msgstr "La configuration de la base de données de Recherche IWAC est indisponible. Ouvrez la page de maintenance pour connaître la marche à suivre avant de réessayer."

