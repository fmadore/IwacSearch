{
  "name": "fmadore/iwac-search",
  "description": "Omeka S module wiring the IWAC archive's public search to Typesense.",
  "type": "omeka-module",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^8.2",
    "symfony/yaml": "^8.1",
    "typesense/typesense-php": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "IwacSearch\\": "src/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^13.4"
  },
  "autoload-dev": {
    "psr-4": {
      "IwacSearch\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true
  }
}
