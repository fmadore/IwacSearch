{
  "name": "fmadore/iwac-search",
  "description": "Omeka S module wiring the IWAC archive's public search to Typesense.",
  "type": "omeka-module",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/container": "^1.1 || ^2.0",
    "psr/log": "^2.0 || ^3.0",
    "typesense/typesense-php": "^6.0",
    "symfony/yaml": "^7.0",
    "guzzlehttp/guzzle": "^7.10",
    "php-http/guzzle7-adapter": "^1.1",
    "http-interop/http-factory-guzzle": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "IwacSearch\\": "src/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "IwacSearch\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
