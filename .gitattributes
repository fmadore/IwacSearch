# Line endings are LF in the repo AND in the working tree, on every platform.
#
# Without this, a Windows checkout with core.autocrlf=true converts to CRLF on
# the way out, which puts the working tree at odds with Prettier's
# `endOfLine: "lf"` (.prettierrc.json): `npm run lint` then fails on every
# file in the repo, including ones nobody touched, and the only way to make it
# pass is to reformat the whole tree. `eol=lf` overrides core.autocrlf per
# repository, so the guard stays meaningful and contributors don't need
# matching global git config.
#
# `text=auto` still lets git detect and skip binaries; the repo currently
# tracks none, but the explicit rules below keep that true if any land.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# Keep the dev toolchain out of `git archive` output (the source zip/tarball
# GitHub attaches to every release, and the `composer create-project` path).
#
# NOTE: this alone does NOT make the source tarball installable — `vendor/` is
# gitignored, so a `git archive` export can never be a working Omeka S module.
# The installable artifact is the release zip built by the release workflow
# (module tree + `composer install --no-dev` vendor/ + the committed
# asset/dist). These rules exist so that artifact, and the auto-generated
# source archives, carry only what ships.
/.github/       export-ignore
/scripts/       export-ignore
/tests/         export-ignore
/tools/         export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/.prettierignore export-ignore
/.prettierrc.json export-ignore
/CLAUDE.md      export-ignore
/ROADMAP.md     export-ignore
/eslint.config.js export-ignore
/package.json   export-ignore
/package-lock.json export-ignore
/phpstan.neon   export-ignore
/phpunit.xml    export-ignore
/tokens.json    export-ignore
/tsconfig.json  export-ignore
/vite.config.ts export-ignore
/vitest.config.ts export-ignore
