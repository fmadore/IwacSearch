{
  "name": "iwac-search-client",
  "version": "3.6.0",
  "description": "Svelte client for the IwacSearch Omeka S module — public discovery surface backed by Typesense.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run lint:theme && npm run lint:drift && npm run build:public && npm run build:header",
    "build:public": "cross-env IWAC_BUNDLE=public vite build",
    "build:header": "cross-env IWAC_BUNDLE=header vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:theme": "node scripts/check-theme-tokens.js",
    "lint:drift": "node scripts/check-schema-drift.js",
    "lint": "npm run lint:theme && npm run lint:drift && eslint src/svelte src/svelte-shared scripts && prettier --check \"src/svelte/**/*.{ts,svelte}\" \"src/svelte-shared/**/*.{ts,svelte}\" \"scripts/**/*.js\" \"*.{ts,json,md}\"",
    "lint:fix": "eslint src/svelte src/svelte-shared scripts --fix && prettier --write \"src/svelte/**/*.{ts,svelte}\" \"src/svelte-shared/**/*.{ts,svelte}\" \"scripts/**/*.js\" \"*.{ts,json,md}\"",
    "format": "prettier --write \"src/svelte/**/*.{ts,svelte}\" \"src/svelte-shared/**/*.{ts,svelte}\" \"scripts/**/*.js\" \"*.{ts,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.0",
    "tslib": "^2.8.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.0"
  },
  "dependencies": {}
}
