{
  "name": "iwac-search-client",
  "version": "0.2.27",
  "description": "Svelte client for the IwacSearch Omeka S module — public discovery surface backed by Typesense.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:public && npm run build:admin && npm run build:header",
    "build:public": "cross-env IWAC_BUNDLE=public vite build",
    "build:admin": "cross-env IWAC_BUNDLE=admin vite build",
    "build:header": "cross-env IWAC_BUNDLE=header vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src/svelte src/svelte-admin src/svelte-shared && prettier --check \"src/svelte/**/*.{ts,svelte}\" \"src/svelte-admin/**/*.{ts,svelte}\" \"src/svelte-shared/**/*.{ts,svelte}\" \"*.{ts,json,md}\"",
    "lint:fix": "eslint src/svelte src/svelte-admin src/svelte-shared --fix && prettier --write \"src/svelte/**/*.{ts,svelte}\" \"src/svelte-admin/**/*.{ts,svelte}\" \"src/svelte-shared/**/*.{ts,svelte}\" \"*.{ts,json,md}\"",
    "format": "prettier --write \"src/svelte/**/*.{ts,svelte}\" \"src/svelte-admin/**/*.{ts,svelte}\" \"src/svelte-shared/**/*.{ts,svelte}\" \"*.{ts,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.0",
    "tslib": "^2.8.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0"
  },
  "dependencies": {}
}
