{
  "name": "iwac-search-client",
  "version": "3.27.2",
  "description": "Svelte client for the IwacSearch Omeka S module — public discovery surface backed by Typesense.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run lint:theme && npm run lint:drift && npm run lint:i18n && npm run build:public && npm run build:header && npm run check:size",
    "build:public": "cross-env IWAC_BUNDLE=public vite build",
    "build:header": "cross-env IWAC_BUNDLE=header vite build",
    "check:size": "node scripts/check-bundle-size.js",
    "build:mo": "node scripts/build-mo.js",
    "build:pot": "node scripts/build-pot.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:versions": "node scripts/check-versions.js",
    "check:audit": "node scripts/check-audit.js",
    "check:maplibre": "node scripts/check-maplibre-pins.js",
    "check:lighthouse": "node scripts/check-lighthouse.js",
    "capture:lighthouse": "node scripts/lighthouse/capture.js",
    "bump": "node scripts/bump-version.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:browser": "npm run build:public && playwright test",
    "lint:theme": "node scripts/check-theme-tokens.js",
    "lint:drift": "node scripts/check-schema-drift.js",
    "lint:i18n": "node scripts/check-i18n.js",
    "lint:docblocks": "node scripts/check-docblocks.js",
    "lint:pot": "node scripts/build-pot.js --check",
    "lint:mo": "node scripts/build-mo.js --check",
    "lint": "npm run lint:theme && npm run lint:drift && npm run lint:i18n && npm run lint:docblocks && npm run lint:pot && npm run lint:mo && eslint src/svelte src/svelte-shared scripts tests playwright.config.ts && prettier --check \"src/svelte/**/*.{ts,svelte}\" \"src/svelte-shared/**/*.{ts,svelte}\" \"scripts/**/*.js\" \"tests/client/**/*.{ts,svelte}\" \"tests/browser/**/*.ts\" \"*.{ts,json,md}\"",
    "lint:fix": "eslint src/svelte src/svelte-shared scripts tests playwright.config.ts --fix && prettier --write \"src/svelte/**/*.{ts,svelte}\" \"src/svelte-shared/**/*.{ts,svelte}\" \"scripts/**/*.js\" \"tests/client/**/*.{ts,svelte}\" \"tests/browser/**/*.ts\" \"*.{ts,json,md}\"",
    "format": "prettier --write \"src/svelte/**/*.{ts,svelte}\" \"src/svelte-shared/**/*.{ts,svelte}\" \"scripts/**/*.js\" \"tests/client/**/*.{ts,svelte}\" \"tests/browser/**/*.ts\" \"*.{ts,json,md}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.3",
    "chrome-launcher": "^1.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
