<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var ?string $slug
 * @var bool $placeholder
 */

$this->headTitle($slug ? "Browse: {$slug}" : 'Browse');
?>
<main class="iwac-browse-shell" role="main">
    <h1><?= $slug ? $this->escapeHtml(ucfirst($slug)) : 'Browse' ?></h1>
    <?php if ($placeholder): ?>
        <p>
            <em>Curated browse pages land in M3 (replaces FacetedBrowse).</em>
        </p>
    <?php endif; ?>
</main>
