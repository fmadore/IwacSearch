<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \IwacSearch\Browse\BrowseConfig $config
 * @var array $bootstrap   Same shape /search emits — see SearchController::browseAction.
 *
 * Curated browse page. Server-rendered title + intro for SEO; Svelte
 * client mounts via the shared common/iwac-search-mount partial.
 */

use IwacSearch\Browse\BrowseContent;

$locale  = $this->iwacLocale();
$content = BrowseContent::localize($config, $locale);

// Section label for the document <title> only, e.g. "Bénin · Parcourir · …".
$browseTitle = $locale === 'en' ? 'Browse' : 'Parcourir';

$this->headTitle($content['title'] . ' · ' . $browseTitle . ' · Islam West Africa Collection');
$blockId = (string) $bootstrap['block_id'];
?>
<main class="iwac-search-shell iwac-browse-page" role="main">
    <header class="iwac-browse-page__header">
        <h1 class="iwac-search-block__title"><?= $this->escapeHtml($content['title']) ?></h1>
        <?php if ($content['introHtml'] !== ''): ?>
            <div class="iwac-browse-page__intro">
                <?= $content['introHtml'] /* localized template / admin-authored, intentional raw HTML */ ?>
            </div>
        <?php endif; ?>
    </header>

    <noscript>
        <p>This curated browse page requires JavaScript. Browse the
            <a href="<?= $this->escapeHtmlAttr($this->basePath('/s/afrique_ouest')) ?>">
                French
            </a>
            or
            <a href="<?= $this->escapeHtmlAttr($this->basePath('/s/westafrica')) ?>">
                English
            </a>
            site instead.
        </p>
    </noscript>

    <?= $this->partial('common/iwac-search-mount', [
        'bootstrap'      => $bootstrap,
        'block_id'       => $blockId,
        'skeleton_rows'  => 5,
    ]) ?>
</main>

<style>
    .iwac-browse-page__header {
        margin-block-end: var(--space-lg, 1.5rem);
    }
    .iwac-browse-page__intro {
        color: var(--ink-light, var(--ink, #444));
        max-width: var(--measure-narrow, 44rem);
    }
    .iwac-browse-page__intro p {
        margin: 0;
    }
</style>
