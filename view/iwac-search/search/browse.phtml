<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \IwacSearch\Browse\BrowseConfig $config
 * @var array $bootstrap   Same shape /search emits — see SearchController::browseAction.
 *
 * Curated browse page. Server-rendered title + intro for SEO; Svelte
 * client mounts into the same root + state contract used by /search and
 * the page block.
 */

$this->headTitle($config->title . ' · Browse · Islam West Africa Collection');

// Resolve runtime endpoints — the controller pre-baked URL stems but
// didn't know the site mount prefix at construction time.
$bootstrap['endpoints']['token']  = $this->basePath($bootstrap['endpoints']['token']);
$bootstrap['endpoints']['search'] = $this->basePath($bootstrap['endpoints']['search']);
$blockId = (string) $bootstrap['block_id'];
?>
<main class="iwac-search-shell iwac-browse-page" role="main">
    <nav class="iwac-browse-page__crumbs" aria-label="Breadcrumb">
        <a href="<?= $this->escapeHtmlAttr($this->basePath('/browse')) ?>">Browse</a>
        <span aria-hidden="true">›</span>
        <span><?= $this->escapeHtml($config->title) ?></span>
    </nav>

    <header class="iwac-browse-page__header">
        <h1 class="iwac-search-block__title"><?= $this->escapeHtml($config->title) ?></h1>
        <?php if ($config->introHtml !== ''): ?>
            <div class="iwac-browse-page__intro">
                <?= $config->introHtml /* admin-authored, intentional raw HTML */ ?>
            </div>
        <?php endif; ?>
    </header>

    <noscript>
        <p>This curated browse page requires JavaScript. Browse the
            <a href="<?= $this->escapeHtmlAttr($this->basePath('/s/afrique_ouest')) ?>">
                French
            </a>
            or
            <a href="<?= $this->escapeHtmlAttr($this->basePath('/s/westafrica')) ?>">
                English
            </a>
            site instead.
        </p>
    </noscript>

    <div data-iwac-search-root
         data-iwac-block-id="<?= $this->escapeHtmlAttr($blockId) ?>"
         class="iwac-search-block iwac-search-block--full iwac-search-block__root"
         id="iwac-search-root-<?= $this->escapeHtmlAttr($blockId) ?>">
        <div class="iwac-search-block__skeleton" aria-hidden="true">
            <div class="iwac-search-block__skeleton-input"></div>
            <div class="iwac-search-block__skeleton-results">
                <?php for ($i = 0; $i < 5; $i++): ?>
                    <div class="iwac-search-block__skeleton-row"></div>
                <?php endfor; ?>
            </div>
        </div>
    </div>

    <script type="application/json" id="iwac-search-state-<?= $this->escapeHtmlAttr($blockId) ?>">
        <?= json_encode($bootstrap, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>
    </script>
</main>

