<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array $bootstrap   Federated config blob (variant=federated).
 *
 * The federated "search everything" shell. Mount + state contract is rendered
 * by common/iwac-federated-mount; this template only carries the page chrome.
 *
 * Asset injection is centralised in Module.php (view.layout on SearchController)
 * — the Svelte bundle loads automatically on this route.
 */

$locale  = $this->iwacLocale();
$isEn    = $locale === 'en';
$heading = $isEn ? 'Search everything' : 'Tout rechercher';
$this->headTitle(($isEn ? 'Search everything' : 'Tout rechercher') . ' · Islam West Africa Collection');
?>
<div class="iwac-search-shell">
    <?php // The theme's page-title treatment (h1.title: a 2px ink rule above a
    // compact section head), exactly like its own page titles ("Browse"). ?>
    <h1 class="title"><?= $this->escapeHtml($heading) ?></h1>

    <noscript>
        <?php // The shell's own locale switch, like the heading: this route may
        // have no site context, so Omeka's translator locale is not the page's. ?>
        <p><?= $isEn ? 'This search requires JavaScript. Browse the' : 'Cette recherche nécessite JavaScript. Parcourez plutôt le site en' ?>
            <a href="<?= $this->escapeHtmlAttr($this->basePath('/s/' . \IwacSearch\IwacInstance::SITE_SLUG_FR)) ?>"><?= $isEn ? 'French' : 'français' ?></a>
            <?= $isEn ? 'or' : 'ou en' ?>
            <a href="<?= $this->escapeHtmlAttr($this->basePath('/s/' . \IwacSearch\IwacInstance::SITE_SLUG_EN)) ?>"><?= $isEn ? 'English' : 'anglais' ?></a><?= $isEn ? ' site instead.' : '.' ?>
        </p>
    </noscript>

    <?= $this->partial('common/iwac-federated-mount', [
        'bootstrap' => $bootstrap,
        'block_id'  => 'everything',
    ]) ?>
</div>
