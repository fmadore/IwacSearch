<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array $bootstrap
 *
 * Standalone /search shell. The mount + state contract is rendered by
 * the shared common/iwac-search-mount partial, so this template only
 * carries the page-specific chrome (title, noscript fallback).
 *
 * Asset injection is centralised in Module.php (attachListeners on the
 * site layout) — the Svelte bundle loads automatically on this route.
 */

$locale = $this->iwacLocale();
$isEn   = $locale === 'en';
$heading = $isEn ? 'Search the IWAC archive' : 'Rechercher dans les archives IWAC';
$this->headTitle(($isEn ? 'Search' : 'Recherche') . ' · Islam West Africa Collection');
?>
<div class="iwac-search-shell">
    <h1 class="iwac-search-block__title"><?= $this->escapeHtml($heading) ?></h1>

    <noscript>
        <?php // The shell's own locale switch, like the heading: this route may
        // have no site context, so Omeka's translator locale is not the page's. ?>
        <p><?= $isEn ? 'This search requires JavaScript. Browse the' : 'Cette recherche nécessite JavaScript. Parcourez plutôt le site en' ?>
            <a href="<?= $this->escapeHtmlAttr($this->basePath('/s/' . \IwacSearch\IwacInstance::SITE_SLUG_FR)) ?>"><?= $isEn ? 'French' : 'français' ?></a>
            <?= $isEn ? 'or' : 'ou en' ?>
            <a href="<?= $this->escapeHtmlAttr($this->basePath('/s/' . \IwacSearch\IwacInstance::SITE_SLUG_EN)) ?>"><?= $isEn ? 'English' : 'anglais' ?></a><?= $isEn ? ' site instead.' : '.' ?>
        </p>
    </noscript>

    <?= $this->partial('common/iwac-search-mount', [
        'bootstrap'      => $bootstrap,
        'block_id'       => 'standalone',
        'skeleton_rows'  => 5,
    ]) ?>
</div>
