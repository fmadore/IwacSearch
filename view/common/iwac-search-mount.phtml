<?php
/**
 * Shared Svelte mount point for the public discovery surfaces.
 *
 *   - /search standalone shell  (block_id = 'standalone')
 *   - page block instances      (block_id = numeric, the SitePageBlock id)
 *
 * Renders three things, in order, that the Svelte client (src/svelte/main.ts)
 * relies on as a contract:
 *
 *   1. A <div data-iwac-search-root data-iwac-block-id="..."> mount target.
 *      data-iwac-heading-level is 3 when the page prints a heading of its own
 *      right above the surface (a titled block's h2, the theme's "Items" h2
 *      on an item set), else 2: the client's "Filters" / "Results" headings,
 *      and the result titles one level below them, then nest under it
 *      instead of beside it (src/svelte/lib/headings.ts).
 *   2. A static skeleton inside it so the page doesn't reflow when Svelte
 *      replaces the content.
 *   3. A sibling <script type="application/json" id="iwac-search-state-...">
 *      whose contents are parsed by main.ts to build the IwacBootstrap.
 *
 * Touching this file means re-checking the mount contract in:
 *   - src/svelte/main.ts (`readBootstrap`)
 *   - the block layout PHTML, /search PHTML, /browse PHTML
 *   - tests/lighthouse/fixtures/, which copy this markup from the live site:
 *     re-capture them (`npm run capture:lighthouse`) once the change is live
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array<string, mixed> $bootstrap          Server-built config blob.
 * @var int|string $block_id                     The mount instance id.
 * @var int $skeleton_rows                       How many placeholder rows to show.
 *                                               Tuned per surface (block: 3, full
 *                                               shells: 5).
 * @var int $heading_level                       Optional: 3 under a heading of the
 *                                               page's own, else 2 (the default).
 */

// Resolve mount-prefix-sensitive endpoints at view time. The controller
// pre-bakes URL stems but doesn't know the site mount prefix at construction.
$bootstrap['endpoints']['token']  = $this->basePath($bootstrap['endpoints']['token']);
$bootstrap['endpoints']['search'] = $this->basePath($bootstrap['endpoints']['search']);

// Stamp the site locale so the Svelte client picks French or English UI
// strings + facet/type labels. Detected from the current site (defaults
// to French off-site, e.g. the global /search route).
$bootstrap['locale'] = $this->iwacLocale();

$rows = isset($skeleton_rows) ? max(0, (int) $skeleton_rows) : 3;
$id   = (string) $block_id;
// Only 2 or 3 mean anything to the client (lib/headings.ts parseHeadingLevel).
$headingLevel = isset($heading_level) && (int) $heading_level === 3 ? 3 : 2;
?>
<div
    data-iwac-search-root
    data-iwac-block-id="<?= $this->escapeHtmlAttr($id) ?>"
    data-iwac-heading-level="<?= $headingLevel ?>"
    class="iwac-search-block__root"
    id="iwac-search-root-<?= $this->escapeHtmlAttr($id) ?>"
>
    <div class="iwac-search-block__skeleton" aria-hidden="true">
        <div class="iwac-search-block__skeleton-input"></div>
        <div class="iwac-search-block__skeleton-results">
            <?php for ($i = 0; $i < $rows; $i++): ?>
                <div class="iwac-search-block__skeleton-row"></div>
            <?php endfor; ?>
        </div>
    </div>
</div>

<script type="application/json" id="iwac-search-state-<?= $this->escapeHtmlAttr($id) ?>">
<?= $this->iwacBootstrapJson($bootstrap) ?>
</script>
