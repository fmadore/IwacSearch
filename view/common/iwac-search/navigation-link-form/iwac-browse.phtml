<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Site\Navigation\Link\LinkInterface $link
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var array<string, mixed> $data        Existing field values when editing.
 *
 * Form rendered inside Omeka's site-navigation editor when the admin
 * picks "IWAC Browse" as a link type. Two fields:
 *   - label      : optional override (defaults to the config's title)
 *   - browse_id  : required FK to iwac_browse_config.id
 *
 * The repository is read directly via the service locator because our
 * BrowseConfig data lives in our own DBAL-backed table — there is no
 * Omeka API adapter for it (yet). One small read per form render is
 * acceptable for an admin-only surface.
 *
 * data-name attributes are NOT decorative. Omeka's nav-tree JS
 * harvests every input/select with a data-name attribute inside this
 * template and writes the value back into the link's data blob.
 */

use IwacSearch\Browse\BrowseConfigRepository;

$repository = $site->getServiceLocator()->get(BrowseConfigRepository::class);
$configs    = $repository->findAll();

$valueOptions = [];
foreach ($configs as $config) {
    if ($config->id !== null) {
        $valueOptions[(string) $config->id] = $config->title;
    }
}

$select = new \Laminas\Form\Element\Select('browse_id');
$select->setValueOptions($valueOptions)
    ->setEmptyOption($this->translate('Select a browse page'))
    ->setValue((string) ($data['browse_id'] ?? ''))
    ->setAttributes([
        'data-name' => 'browse_id',
        'required'  => true,
    ]);
?>
<label>
    <?php echo $this->translate('Type'); ?>
    <input type="text" value="<?php echo $this->escapeHtml($this->translate($link->getName())); ?>" disabled>
</label>
<label>
    <?php echo $this->translate('Label'); ?>
    <input type="text" data-name="label" value="<?php echo $this->escapeHtml($data['label'] ?? ''); ?>">
</label>
<label class="required">
    <?php echo $this->translate('Page'); ?>
    <?php echo $this->formElement($select); ?>
</label>
